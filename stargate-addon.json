{
  "maintenance_contract": 1,
  "uninstall_contract": 2,
  "id": "alarm-clock",
  "name": "Alarm Clock",
  "repository": "matelv-x/Alarm-Clock",
  "platforms": ["v4"],
  "detect": {"any": [{"path": "classes/alarm_clock_manager.py"}, {"path": "web/alarm_clock.htm"}]},
  "install": {"argv": ["./install.sh"], "env": {"APP_DIR": "{sg1_root}", "ALARM_CLOCK_MODE": "keep"}, "timeout": 1200},
  "uninstall": {"argv": ["./restore.sh"], "env": {"APP_DIR": "{sg1_root}"}, "timeout": 900},
  "archive_integration_files": ["classes/web_server.py", "web/address_book.htm", "web/retro/js/navigation.js"],
  "restart_required": true
}
